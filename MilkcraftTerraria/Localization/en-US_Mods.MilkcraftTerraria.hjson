Progression: {
	T3LicenseActivated: T3 equipment is now permanently unlocked for this character.
	T4LicenseActivated: T4 equipment is now permanently unlocked for this character.
	T3LicenseActive: This character has permanently unlocked T3 equipment.
	T4LicenseActive: This character has permanently unlocked T4 equipment.
	T3LicenseReady: This world can activate the T3 license.
	T4LicenseReady: This world can activate the T4 license.
	T3LicenseLocked: Defeat any Mechanical Boss in this world first.
	T4LicenseLocked: Defeat Golem in this world first.
	T3ChampionTitle: Title unlocked: Mechanical Conqueror.
	T3ChampionUnlocked: All three Mechanical Bosses defeated. Title unlocked: Mechanical Conqueror.
}

SetBonuses: {
	Iron: +5% melee damage. Barrier absorbs 10 damage; recharges after 12 seconds.
	Leather: +5% ranged damage and movement speed. Valid ranged hits grant +8% movement speed for 3 seconds (6-second cooldown).
	Cloth: +5% magic damage and 5% reduced mana cost. In combat, restores 10% of mana actually spent (up to 8) every 6 seconds.
	Knight: +8% melee damage and 5% damage reduction. Barrier absorbs 20 damage; breaking it grants +6% melee damage for 3 seconds; recharges after 12 seconds.
	Hunting: +8% ranged damage. The third ranged hit on one enemy deals +15% damage; hits must be at least 15 frames apart.
	Energy: 10% reduced mana cost and +3 mana regeneration. After spending 20 mana, a valid magic hit grants a 12-damage barrier; 12-second recharge after it breaks.
	Templar: +2% melee damage. Barrier absorbs 30 damage; recharges after 12 seconds.
	Nightmare: +2% ranged damage. Valid ranged hits summon a 40%-damage homing pursuit every 2 seconds.
	Fallen: +2% magic damage and 10% reduced mana cost. Every 6 seconds in magic combat, restores 10 health and 15% of mana spent (up to 30).
	Soulforged: +4% melee damage and 8% damage reduction. Barrier absorbs 60 damage; breaking it grants +10% melee damage for 4 seconds; recharges after 12 seconds.
	Abyss: +4% ranged damage. Valid ranged hits summon a 65%-damage homing pursuit every 1.5 seconds.
	Dark: +4% magic damage and 10% reduced mana cost. Valid magic hits summon a 60%-damage homing echo every 2 seconds.
}

