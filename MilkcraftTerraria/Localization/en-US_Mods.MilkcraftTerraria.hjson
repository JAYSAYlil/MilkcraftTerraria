	}

	Tooltip: {
		Sharpness: Damage increased by 6%.
		Power: Matching ranged damage increased by 6%.
		Spell: Matching magic damage increased by 6%.
		Critical: Matching class critical chance increased by 4 percentage points.
		Provocation: While held, +400 aggro and +4 defense.
		Stealth: While held, -400 aggro and +4% movement speed.
		ShieldWall: +4% damage reduction.
		Armor: +4 defense.
		Resistance: Enemy projectile damage reduced by 6%.
		Ice: Valid hits slow enemies for 2 seconds.
		Healing: Valid hits heal 2 life at most once every 2 seconds, subject to life-steal budget.
		Explosive: Hits splash 30% damage to nearby enemies; 0.5-second cooldown.
	}
}

